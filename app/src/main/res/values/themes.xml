<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AtlasAppWindow" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/atlas_background</item>
        <item name="android:colorAccent">@color/atlas_accent</item>
        <item name="android:statusBarColor">@color/atlas_background</item>
        <item name="android:navigationBarColor">@color/atlas_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.AtlasAppWindow.Transparent" parent="Theme.AtlasAppWindow">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
